// 放置·修仙之路 — 统一数据库 Schema（合并用户系统 + Game 游戏系统）
//
// 说明（2025-09-11 合并决策）：
// - 用户系统表与游戏系统表合并到同一数据库 idle_game
// - 连接串走 env：DATABASE_URL（由 DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME 组成）
// - 运行时访问采用原生 pg（DatabaseService / GameDatabaseService），
//   本文件为数据设计工件；实际 DDL 由 scripts/init-db.mjs 与 scripts/init-game-db.mjs 执行。
// - 约定：JSON 结构在数据库列中一律以字符串（Text）存储，应用层负责序列化/反序列化。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 用户系统 ============

model users {
  id         Int         @id @default(autoincrement())
  username   String      @unique @db.VarChar(50)
  password   String?     @db.VarChar(255)
  created_at DateTime    @default(now()) @db.Timestamp(6)
  updated_at DateTime    @updatedAt @db.Timestamp(6)
  last_login DateTime?   @db.Timestamp(6)
  status     Int         @default(1) @db.SmallInt
  characters characters?
}

model characters {
  id            Int      @id @default(autoincrement())
  user_id       Int      @unique
  nickname      String   @db.VarChar(50)
  gender        String   @db.VarChar(10)
  title         String?  @default("散修") @db.VarChar(50)
  spirit_stones BigInt   @default(10000)
  silver        BigInt   @default(0) // （弃用）银两，不再使用
  realm         Int      @default(1) @db.SmallInt // 当前境界序号 1~14
  lingyun       BigInt   @default(0) // 灵韵（角色绑定成长资源）
  jade_slips    BigInt   @default(0) // 未开光玉简计数（P2 占位，P4 物品化）
  last_settle_at DateTime @default(now()) @db.Timestamptz(6) // 离线收益结算锚点（P4.2，带时区）
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// ============ Game 游戏系统（P1：物品与词缀） ============

// 物品基底（底材模板）
model game_item_bases {
  id               Int      @id @default(autoincrement())
  code             String   @unique @db.VarChar(50) // 如 t2_qingfengjian
  name             String   @db.VarChar(50)        // 青锋剑
  category         String   @db.VarChar(30)        // weapon/body/helmet/gloves/boots/shield/ring/amulet/belt
  slot             String?  @db.VarChar(20)        // 装备槽位 key
  sub_type         String?  @db.VarChar(30)        // 单手剑/道袍…
  tier             Int      @db.SmallInt           // 底材 T 阶 1~14
  base_stats       String?  @db.Text               // JSON 字符串：基础属性
  implicit_affixes String?  @db.Text               // JSON 字符串：基底词缀 code 列表
  unique_affixes   String?  @db.Text               // JSON 字符串：传奇固定词缀 code 列表
  rarity_limit     Int      @default(2) @db.SmallInt // 最高可达稀有度 0凡/1灵/2宝/3传奇
  drop_weight      Int      @default(100)
  icon             String?  @db.VarChar(100)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @updatedAt @db.Timestamp(6)

  @@index([category])
}

// 词缀池
model game_affixes {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50) // aff_atk_1 等；tier=0 表示无 T 阶（基底/传奇固定）
  name         String   @db.VarChar(50)         // 锋锐
  polarity     String   @db.VarChar(10)         // prefix 前缀 / suffix 后缀 / base 基底
  tier         Int      @db.SmallInt            // 词缀 T 阶 1~14；0=无 T 阶
  effects      String   @db.Text                // JSON 字符串：属性效果
  value_func   String?  @db.Text                // JSON 字符串：{minPerTier, maxPerTier}（可 roll 词缀）
  weight       Int      @default(100)           // 生成权重
  is_fractured Boolean  @default(false)         // 天定词缀（P1 无此类数据，字段预留）
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  @@index([polarity, tier])
}

// 底材-词缀池挂载（每种底材独立前后缀池）
model game_base_affix_pools {
  id        Int    @id @default(autoincrement())
  base_id   Int                                    // → game_item_bases.id
  affix_id  Int                                    // → game_affixes.id
  polarity  String @db.VarChar(10)                 // prefix / suffix

  @@unique([base_id, affix_id])
  @@index([base_id, polarity])
}

// 物品实例
model game_items {
  id           BigInt   @id @default(autoincrement())
  character_id Int?                                // 归属角色；null=无主
  base_id      Int
  rarity       Int      @default(0) @db.SmallInt   // 0凡/1灵/2宝/3传奇
  tier         Int      @db.SmallInt               // 底材 T 阶（冗余自基底）
  quality      Int      @default(0) @db.SmallInt   // 品质 0~20（P3 启用）
  affixes      String?  @db.Text                   // JSON 字符串：[{affixId, value, polarity, key, fractured?}]
  base_stats   String?  @db.Text                   // P3.2 基础属性覆盖（blessed 重 roll 落库）
  mirrored     Boolean  @default(false)            // P3.2 映道镜复制品（不可再复制）
  vaaled       Boolean  @default(false)            // P3.2 瓦尔宝珠已变异（禁一切洗炼）
  status       String   @default("bag") @db.VarChar(20) // bag/equipped/warehouse/selling
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  @@index([character_id, status])
  @@index([base_id])
}

// 装备栏（角色当前穿戴）
model game_equipment {
  id           Int      @id @default(autoincrement())
  character_id Int      @unique
  slots        String   @db.Text                   // JSON 字符串：{"weapon": itemId, "ring1": …}
  updated_at   DateTime @updatedAt @db.Timestamp(6)
}

// ===== 精华定义（P3.3：6 种定向精华，单阶） =====
model game_essences {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(20)
  name          String   @db.VarChar(50)
  polarity      String   @db.VarChar(10)
  target_family String   @db.VarChar(30)
  description   String?  @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)
}

// ===== 角色精华存量 =====
model game_essence_inventory {
  id           Int      @id @default(autoincrement())
  character_id Int
  essence_id   Int
  count        BigInt   @default(0)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  @@unique([character_id, essence_id])
  @@index([character_id])
}

// ===== 通货定义（P3 第一批：7 种炼器核心实装） =====
model game_currencies {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  implemented Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)
}

// ===== 角色通货钱包 =====
model game_wallets {
  id            Int      @id @default(autoincrement())
  character_id  Int
  currency_code String   @db.VarChar(20)
  amount        BigInt   @default(0)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  @@unique([character_id, currency_code])
  @@index([character_id])
}

// ===== P4.2 离线收益日计数 =====
model game_idle_counters {
  id             Int      @id @default(autoincrement())
  character_id   Int
  day            DateTime @db.Date
  items_produced Int      @default(0)
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  @@unique([character_id, day])
}

// ===== P5.1 秘境定义 =====
model game_zones {
  id                     Int      @id @default(autoincrement())
  code                   String   @unique @db.VarChar(50)
  name                   String   @db.VarChar(50)
  chapter                Int      @db.SmallInt
  order_index            Int
  min_realm              Int      @db.SmallInt
  unit_code              String   @db.VarChar(50)
  boss_code              String?  @db.VarChar(50)
  base_power             Int
  power_step             Int
  max_floor              Int      @db.SmallInt
  lingyun_bonus_per_floor Int
  boss_every_floors      Int      @default(10) @db.SmallInt
  require_prev_best_floor Int     @default(0) // 链式解锁：前置秘境 bestFloor 阈值（P5.2）
  tier_bonus_every_floors Int     @default(0) // 每 N 层 tierOffset +1（0=禁用，P5.2）
  drop_bonus_every_floors Int     @default(0) // 每 N 层 +1 掉落判定（0=禁用，P5.2）
  created_at             DateTime @default(now()) @db.Timestamp(6)
  updated_at             DateTime @updatedAt @db.Timestamp(6)

  @@index([order_index])
}

// ===== P5.1 角色×秘境进度 =====
model game_zone_progress {
  id           Int      @id @default(autoincrement())
  character_id Int
  zone_id      Int
  floor        Int      @default(1)
  best_floor   Int      @default(0)
  cleared      Boolean  @default(false)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  @@unique([character_id, zone_id])
  @@index([character_id])
}

// ===== P5.1 角色当前秘境 =====
model game_zone_state {
  id              Int      @id @default(autoincrement())
  character_id    Int      @unique
  current_zone_id Int
  updated_at      DateTime @updatedAt @db.Timestamp(6)
}


// ===== P6 任务定义 =====
model game_quest_defs {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  chapter      Int      @db.SmallInt
  name         String   @db.VarChar(100)
  trigger_type String   @default("auto") @db.VarChar(20)
  trigger_cond String?  @db.Text                      // JSON：{ realm, requires[] }
  objectives   String   @db.Text                      // JSON：[{ type, key?, value?, desc }]
  rewards      String   @db.Text                      // JSON：{ lingyun, spiritStones, jadeSlips, currencies{}, essences{} }
  dialogues    String?  @db.Text
  next_quest   String?  @db.VarChar(50)
  order_index  Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  @@index([order_index])
}

// ===== P6 角色任务进度 =====
model game_quest_progress {
  id           Int       @id @default(autoincrement())
  character_id Int
  quest_code   String    @db.VarChar(50)
  status          String    @default("active") @db.VarChar(20) // active/completed
  objectives      String?   @db.Text
  completed_at    DateTime? @db.Timestamp(6)
  rewards_granted Boolean   @default(false) // 奖励是否已发放（可重试，不丢奖）

  @@unique([character_id, quest_code])
  @@index([character_id])
}


// ===== P7 章节定义 =====
model game_chapters {
  id                Int      @id @default(autoincrement())
  code              String   @unique @db.VarChar(50)
  chapter           Int      @db.SmallInt
  name              String   @db.VarChar(100)
  theme             String?  @db.VarChar(100)
  min_realm         Int      @db.SmallInt
  zone_code         String   @db.VarChar(50)
  quest_start_code  String   @db.VarChar(50)
  quest_end_code    String   @db.VarChar(50)
  requires_chapter  String?  @db.VarChar(50)
  rewards           String   @db.Text
  dialogues         String?  @db.Text
  order_index       Int      @default(0)
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @updatedAt @db.Timestamp(6)

  @@index([order_index])
}

// ===== P7 角色章节进度 =====
model game_chapter_progress {
  id              Int       @id @default(autoincrement())
  character_id    Int
  chapter_id      Int
  status          String    @default("active") @db.VarChar(20)
  rewards_granted Boolean   @default(false)
  completed_at    DateTime? @db.Timestamp(6)

  @@unique([character_id, chapter_id])
  @@index([character_id])
}


// ===== P6.2 通用事件计数 =====
model game_stat_counters {
  id           Int      @id @default(autoincrement())
  character_id Int
  key          String   @db.VarChar(80)
  value        BigInt   @default(0)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  @@unique([character_id, key])
  @@index([character_id])
}

// ===== P7.2 演出已读 =====
model game_story_seen {
  id           Int      @id @default(autoincrement())
  character_id Int
  node_key     String   @db.VarChar(120)
  seen_at      DateTime @default(now()) @db.Timestamp(6)

  @@unique([character_id, node_key])
  @@index([character_id])
}

// 辨宝法阵（拾取规则，P1 仅 CRUD 落库）
model game_pickup_rules {
  id            Int      @id @default(autoincrement())
  character_id  Int                                 // 0 = 系统预置模板
  name          String   @db.VarChar(50)
  rarity_min    Int      @default(0) @db.SmallInt
  tier_min      Int      @default(1) @db.SmallInt
  affix_codes   String?  @db.Text                   // JSON 字符串：目标词缀 code 列表
  action        String   @default("keep") @db.VarChar(20) // keep/salvage/sell/discard
  enabled       Boolean  @default(true)
  priority      Int      @default(100)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  @@index([character_id])
}

// ===== P4 单位系统：隐藏词条定义 =====
model game_unit_hidden_affixes {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(50)
  name       String   @db.VarChar(50)
  effects    String   @db.Text                      // JSON 字符串：隐藏词条效果
  weight     Int      @default(100)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
}

// ===== P4 单位模板 =====
model game_unit_templates {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(50)
  realm          Int      @db.SmallInt              // 境界序号 1~14
  camp           String   @db.VarChar(10)           // hostile/neutral/friendly
  gives_lingyun  Boolean  @default(true)
  base_stats     String?  @db.Text                  // JSON 字符串：境界模板基础属性覆盖
  drop_table_ref Int?                               // → game_drop_tables.id
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  @@index([realm])
  @@index([camp])
}

// ===== P4 单位 ↔ 隐藏词条池 =====
model game_unit_hidden_pools {
  id               Int @id @default(autoincrement())
  unit_template_id Int
  hidden_affix_id  Int

  @@unique([unit_template_id, hidden_affix_id])
  @@index([unit_template_id])
}

// ===== P4 掉落表 =====
model game_drop_tables {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(50)
  drops_per_kill Int      @default(1) @db.SmallInt
  tier_offset    Int      @default(0) @db.SmallInt // Boss 跨阶加成
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)
}

// ===== P4 掉落条目 =====
model game_drop_entries {
  id            Int     @id @default(autoincrement())
  drop_table_id Int
  kind          String  @db.VarChar(20)             // base/currency/essence
  base_id       Int?
  base_tier     Int?    @db.SmallInt
  rarity        Int?    @db.SmallInt
  currency_code String? @db.VarChar(20)
  essence_code  String? @db.VarChar(20)
  min_count     Int     @default(1)
  max_count     Int     @default(1)
  weight        Int     @default(100)

  @@index([drop_table_id])
}

// ===== R2 地图层（settings-revision-2 §5 / §7）=====
// 地图是「地点宿主」：节点可承载系统（feature_key），未实现的系统在 UI 显示未开放，
// 因此地图层的落地不被 炼丹/御兽/PVP 等未实现系统阻塞。
model game_maps {
  id                Int      @id @default(autoincrement())
  code              String   @unique @db.VarChar(50)
  name              String   @db.VarChar(50)
  world             String   @default("great") @db.VarChar(20) // great=大世界 / other=异界
  order_index       Int
  chapter_from      Int      @db.SmallInt
  chapter_to        Int      @db.SmallInt
  requires_map_code String?  @db.VarChar(50)
  description       String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @updatedAt @db.Timestamp(6)

  @@index([order_index])
}

model game_map_nodes {
  id                 Int      @id @default(autoincrement())
  code               String   @unique @db.VarChar(50)
  map_id             Int
  name               String   @db.VarChar(50)
  ring               String   @db.VarChar(20) // outer/approach/peaks/inner/summit
  sector             String?  @db.VarChar(4) // N/NE/E/SE/S/SW/W/NW
  kind               String   @db.VarChar(20) // route/idle_spot/secret_realm/summit
  feature_key        String?  @db.VarChar(20) // 承载的系统；null = 纯跑图
  level              Int      @db.SmallInt // 怪物境界（固定）
  threshold          Int // 固定战力门槛
  has_waypoint       Boolean  @default(false)
  chapter            Int      @db.SmallInt
  requires_node_code String?  @db.VarChar(50)
  zone_code          String?  @db.VarChar(50) // kind=secret_realm 时指向 game_zones.code
  unit_code          String?  @db.VarChar(50) // kind=idle_spot 时指向 game_unit_templates.code（挂机刷什么）
  order_index        Int
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @updatedAt @db.Timestamp(6)

  @@index([map_id, order_index])
}

model game_map_edges {
  id            Int     @id @default(autoincrement())
  map_id        Int
  from_node_id  Int
  to_node_id    Int
  bidirectional Boolean @default(true)

  @@unique([map_id, from_node_id, to_node_id])
  @@index([map_id])
}

// 节点进度：visited=跑图到达；waypoint_unlocked=传送点已点亮；idle_unlocked=可离线挂机（D2）
model game_node_progress {
  id                Int      @id @default(autoincrement())
  character_id      Int
  node_id           Int
  visited           Boolean  @default(false)
  waypoint_unlocked Boolean  @default(false)
  idle_unlocked     Boolean  @default(false)
  cleared           Boolean  @default(false)
  updated_at        DateTime @updatedAt @db.Timestamp(6)

  @@unique([character_id, node_id])
  @@index([character_id])
}

