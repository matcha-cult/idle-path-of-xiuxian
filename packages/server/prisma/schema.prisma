// 放置·修仙之路 — 用户系统独立数据库 Schema
//
// 注意：
// - 本数据库为新建数据库，不继承任何参考项目/废案数据库。
// - 当前角色系统与 idle-matcha / stock-market-service 等参考废案不兼容。
// - 本 Schema 仅包含用户系统所需表：users、characters。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_SERVICE_DATABASE_URL")
}

model users {
  id         Int         @id @default(autoincrement())
  username   String      @unique @db.VarChar(50)
  password   String?     @db.VarChar(255)
  created_at DateTime    @default(now()) @db.Timestamp(6)
  updated_at DateTime    @updatedAt @db.Timestamp(6)
  last_login DateTime?   @db.Timestamp(6)
  status     Int         @default(1) @db.SmallInt
  characters characters?
}

model characters {
  id            Int      @id @default(autoincrement())
  user_id       Int      @unique
  nickname      String   @db.VarChar(50)
  gender        String   @db.VarChar(10)
  title         String?  @default("散修") @db.VarChar(50)
  spirit_stones BigInt   @default(10000)
  silver        BigInt   @default(0)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}
