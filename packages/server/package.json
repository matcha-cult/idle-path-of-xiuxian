{
  "name": "idle-path-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:init": "node scripts/init-db.mjs",
    "db:init:game": "node scripts/init-game-db.mjs",
    "check:deps": "tsx scripts/check-deps.mts",
    "verify": "pnpm run typecheck && pnpm run typecheck:test && pnpm run check:deps && pnpm run test:unit",
    "smoke:ws": "tsx scripts/ws-smoke.mts",
    "e2e:idle": "tsx scripts/e2e-idle.mts",
    "e2e:all": "tsx scripts/e2e-all.mts",
    "e2e:journey": "tsx scripts/e2e-journey.mts",
    "test:unit": "tsx --test \"test/**/*.test.ts\"",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "coverage:report": "tsx scripts/coverage-report.mts",
    "verify:sendto": "tsx scripts/verify-sendto.mts",
    "gen:map-seed": "node scripts/gen-map-seed.mjs"
  },
  "dependencies": {
    "@nbb-ionet/core-framework": "workspace:*",
    "@nbb-ionet/extension-nestjs": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-ws": "^10.4.0",
    "@nestjs/websockets": "^10.4.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.3",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
