# 放置·修仙之路 Server 环境变量示例
NODE_ENV=development

# HTTP 端口
PORT=3000

# 用户系统独立数据库（新建数据库，不继承任何参考项目/废案数据库）
USER_SERVICE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/idle_path_of_xiuxian_user?schema=public

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=604800

# 创建角色默认灵石
DEFAULT_REGISTRATION_SPIRIT_STONES=10000
