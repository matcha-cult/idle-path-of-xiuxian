# 放置·修仙之路 Server 环境变量示例
NODE_ENV=development

# HTTP 端口
PORT=3000

# 统一数据库（用户系统 + Game 游戏系统合并）
# DATABASE_URL 由以下片段组成；Prisma 读取 DATABASE_URL，业务代码亦可用片段拼装
DB_HOST=localhost
DB_PORT=35432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=idle_game
DATABASE_URL=postgresql://postgres:change-me@localhost:35432/idle_game?schema=public

# Redis（健康检测探测用）
REDIS_URL=redis://localhost:6379

# 词缀 roll 窗口 N：可 roll 词缀 T 阶范围 = [底材T - N, 底材T]，默认 4
AFFIX_TIER_WINDOW=4

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=604800

# 创建角色默认灵石
DEFAULT_REGISTRATION_SPIRIT_STONES=10000